{
  "profiles": {
    "Docker Compose": {
      "commandName": "DockerCompose",
      "commandVersion": "1.0",
      "composeLaunchAction": "LaunchBrowser",
      "composeLaunchServiceName": "webapi",
      "composeLaunchUrl": "{Scheme}://localhost:{ServicePort}/swagger/index.html",
      "serviceActions": {
        "webapi": "StartDebugging",
        "rabbitmq": "StartWithoutDebugging",
        "SqlServerDb": "StartWithoutDebugging"
      }
    }
  }
}